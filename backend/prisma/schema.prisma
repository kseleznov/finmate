generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum OperationType {
  INCOME
  EXPENSE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories     Category[]
  operations     Operation[]
  budgets        BudgetLimit[]
  monthlyIncomes MonthlyIncome[]
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType @default(EXPENSE)
  icon      String
  color     String
  userId    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations Operation[]
  budgets    BudgetLimit[]
}

model Operation {
  id            String        @id @default(cuid())
  title         String
  description   String?
  amount        Float
  type          OperationType
  date          DateTime
  paymentMethod String        @default("cash")
  categoryId    String?
  userId        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model BudgetLimit {
  id         String   @id @default(cuid())
  categoryId String
  userId     String
  month      String
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month, userId])
}

model MonthlyIncome {
  id        String   @id @default(cuid())
  userId    String
  month     String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}
